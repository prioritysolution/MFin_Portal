# Public environment variables (safe for the browser).
# Copy to `.env.local` or `.env` for local development.
# Never put secrets, private API keys, database credentials, or signing keys in NEXT_PUBLIC_*.

# Backend API origin used by the central API client (src/lib/api/client.ts)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Application environment: development | test | production
NEXT_PUBLIC_APP_ENV=development

# --- Server-only variables ---
# Auth session uses an httpOnly AES-GCM sealed cookie set by the Next.js BFF (`/api/auth/*`).
# Required: at least 32 characters. Never put this in NEXT_PUBLIC_*.
# Generate e.g. `openssl rand -base64 48`
AUTH_SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Do not expose Laravel Bearer tokens through NEXT_PUBLIC_* variables.

# Support desk API used only by the server when listing or raising tickets.
# Never put the key or secret in NEXT_PUBLIC_*.
# Raise sends SUPPORT_API_DOMAIN (or the organization website host) and the API key.
# The API secret is not sent from this portal.
SUPPORT_API_URL=http://localhost:8000/api
SUPPORT_API_KEY=pk_live_your_key
SUPPORT_API_SECRET=your_secret
SUPPORT_API_DOMAIN=
